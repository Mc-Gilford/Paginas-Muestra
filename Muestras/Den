<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Para ti</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", sans-serif;
    }

    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at top, rgba(255, 120, 180, 0.35), transparent 35%),
        linear-gradient(135deg, #120015, #250022, #050008);
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow: hidden;
      padding: 20px;
    }

    .stars {
      position: fixed;
      width: 100%;
      height: 100%;
      background-image:
        radial-gradient white 1px, transparent 1px;
      background-size: 40px 40px;
      opacity: 0.15;
      animation: moveStars 20s linear infinite;
    }

    @keyframes moveStars {
      from { transform: translateY(0); }
      to { transform: translateY(-200px); }
    }

    .card {
      position: relative;
      z-index: 2;
      max-width: 520px;
      width: 100%;
      padding: 40px 30px;
      border-radius: 30px;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      box-shadow: 0 0 60px rgba(255, 80, 160, 0.25);
      text-align: center;
    }

    .heart {
      font-size: 52px;
      margin-bottom: 15px;
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.15); }
    }

    h1 {
      font-size: 2.2rem;
      margin-bottom: 15px;
      background: linear-gradient(90deg, #ff8acb, #ffd1e8, #ffffff);
      -webkit-background-clip: text;
      color: transparent;
    }

    p {
      color: #f7dbe8;
      line-height: 1.6;
      font-size: 1rem;
    }

    .timer {
      display: flex;
      justify-content: center;
      gap: 12px;
      margin: 30px 0;
      flex-wrap: wrap;
    }

    .box {
      min-width: 75px;
      padding: 14px 10px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.12);
      border: 1px solid rgba(255, 255, 255, 0.16);
    }

    .box span {
      display: block;
      font-size: 1.7rem;
      font-weight: bold;
    }

    .box small {
      color: #ffc6df;
      font-size: 0.75rem;
    }

    .secret {
      display: none;
      animation: fadeIn 1.4s ease forwards;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .btn {
      margin-top: 25px;
      display: inline-block;
      padding: 13px 25px;
      border-radius: 999px;
      background: linear-gradient(90deg, #ff4fa3, #ff9dcc);
      color: white;
      text-decoration: none;
      font-weight: bold;
      box-shadow: 0 0 25px rgba(255, 79, 163, 0.45);
    }
  </style>
</head>

<body>
  <div class="stars"></div>

  <main class="card">
    <div class="heart">💗</div>

    <section id="locked">
      <h1>Algo especial está por llegar</h1>
      <p>
        Esta página todavía no puede abrirse completamente.
        Vuelve cuando el reloj marque las 12:00.
      </p>

      <div class="timer">
        <div class="box"><span id="days">00</span><small>Días</small></div>
        <div class="box"><span id="hours">00</span><small>Horas</small></div>
        <div class="box"><span id="minutes">00</span><small>Min</small></div>
        <div class="box"><span id="seconds">00</span><small>Seg</small></div>
      </div>
    </section>

    <section id="secret" class="secret">
      <h1>Feliz cumpleaños ✨</h1>
      <p>
        Hoy quería regalarte algo distinto.  
        Algo sencillo, pero hecho con intención.
        Espero que este día te recuerde lo valiosa que eres
        y lo bonito que es que existas.
      </p>

      <a class="btn" href="https://www.youtube.com/watch?v=eX5FfgshS1M">Da click aqui con cariño 💕</a>
    </section>
  </main>

  <script>
    // Cambia esta fecha a la que quieras.
    // Formato: año, mes - 1, día, hora, minuto, segundo
    // Ejemplo: 29 de mayo de 2026 a las 12:00 a.m.
    const openingDate = new Date(2026, 4, 30, 0, 0, 0);

    const locked = document.getElementById("locked");
    const secret = document.getElementById("secret");

    function updateTimer() {
      const now = new Date();
      const diff = openingDate - now;

      if (diff <= 0) {
        locked.style.display = "none";
        secret.style.display = "block";
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      document.getElementById("days").textContent = String(days).padStart(2, "0");
      document.getElementById("hours").textContent = String(hours).padStart(2, "0");
      document.getElementById("minutes").textContent = String(minutes).padStart(2, "0");
      document.getElementById("seconds").textContent = String(seconds).padStart(2, "0");
    }

    updateTimer();
    setInterval(updateTimer, 1000);
  </script>
</body>
</html>
